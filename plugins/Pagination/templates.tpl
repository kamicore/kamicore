<!-- kami:template pagination -->
<nav class="pagination" aria-label="Pagination">{{items}}</nav>
<!-- /kami:template -->

<!-- kami:template pagination-item -->
<a class="pagination-item {{class}}" href="{{url}}">{{label}}</a>
<!-- /kami:template -->

<!-- kami:template pagination-current -->
<span class="pagination-item pagination-current" aria-current="page">{{label}}</span>
<!-- /kami:template -->

<!-- kami:template pagination-ellipsis -->
<span class="pagination-item pagination-ellipsis" aria-hidden="true">…</span>
<!-- /kami:template -->
